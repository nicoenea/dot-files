#!/usr/bin/env python3
"""Send Moni-A to wake the Skydimo SK0L27 into PC-control mode.

The strip boots in standalone firmware mode and ignores all Adalight/Direct
colour data until it receives this command. Run once at login before OpenRGB
starts so the effects plugin can drive it immediately.
"""

import serial
import sys
import time

DEVICE = '/dev/ttyUSB0'
BAUD   = 115200

for _ in range(30):
    try:
        ser = serial.Serial(DEVICE, BAUD, timeout=1)
        break
    except serial.SerialException:
        time.sleep(1)
else:
    sys.exit(f'skydimo-init: could not open {DEVICE} after 30 s')

ser.write(b'Moni-A')
time.sleep(0.2)
ser.close()
